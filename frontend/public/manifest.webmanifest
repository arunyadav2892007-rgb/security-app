{
  "name": "ECCO Road Safety Academy",
  "short_name": "ECCO Safety",
  "description": "Official ECCO Road Safety examination portal, defensive driving MCQ test, and verified certificate generation.",
  "start_url": "/",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0f172a",
  "theme_color": "#1a6c7a",
  "categories": ["education", "business", "utilities"],
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Take MCQ Exam",
      "short_name": "Start Exam",
      "description": "Begin the 15-question road safety certification test",
      "url": "/?action=exam",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    },
    {
      "name": "Verify Certificate",
      "short_name": "Verify",
      "description": "Look up and verify an issued road safety certificate",
      "url": "/?action=verify",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192" }]
    }
  ]
}
